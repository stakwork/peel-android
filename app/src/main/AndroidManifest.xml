<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice messages (VoiceRecorder): the mic for a press-and-hold
         recording, requested at runtime, same as the system picker and
         camera already needed no manifest-time grant beyond this. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Calls (CallSession): the camera for a video call, requested at
         runtime, same as the mic above — RECORD_AUDIO already covers a
         call's own microphone, this is the one call-specific addition. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Network policy: usesCleartextTraffic/networkSecurityConfig only govern
         the platform HTTP stack (HttpURLConnection, OkHttp). Raw sockets (the
         MQTT client's Netty, LiveKit's media connection) ignore them, so
         real enforcement is in code (NetworkPolicy, Transport, CallServer). -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <!-- adjustNothing: MainActivity's root already applies
                 safeDrawingPadding(), which includes the IME inset. If the
                 system also resized the window for the keyboard, content
                 would shift twice (a gap above the keyboard). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An invite link, sphinx.chat://?action=i&d=… (the official apps' scheme; Peel's own is
                 not decided, docs/phases/19-invites.md). Only fills in the onboarding's invite step:
                 nothing is joined or paid by opening a link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sphinx.chat" />
            </intent-filter>
        </activity>

        <!-- Hands a downloaded attachment to whatever app the person
             picks to open it with (video/audio/PDF/file — an image
             shows inline instead), as a content:// URI rather than a
             raw file:// path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
