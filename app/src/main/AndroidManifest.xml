<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice messages (VoiceRecorder): the mic for a press-and-hold
         recording, requested at runtime, same as the system picker and
         camera already needed no manifest-time grant beyond this. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Calls (CallSession): the camera for a video call, requested at
         runtime, same as the mic above — RECORD_AUDIO already covers a
         call's own microphone, this is the one call-specific addition. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Push and notifications (push/): POST_NOTIFICATIONS is a runtime
         permission from Android 13; the full-screen intent is for a call
         someone starts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The call foreground service (call/CallService): a microphone (and,
         with the camera granted, camera) service type, each with its own
         permission from Android 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Screen share: the capture runs in LiveKit's own mediaProjection
         service (merged in from the SDK), which needs this permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Network policy: usesCleartextTraffic/networkSecurityConfig only govern
         the platform HTTP stack (HttpURLConnection, OkHttp). Raw sockets (the
         MQTT client's Netty, LiveKit's media connection) ignore them, so
         real enforcement is in code (NetworkPolicy, Transport, CallServer). -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <!-- adjustNothing: MainActivity's root already applies
                 safeDrawingPadding(), which includes the IME inset. If the
                 system also resized the window for the keyboard, content
                 would shift twice (a gap above the keyboard). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- An invite link, sphinx.chat://?action=i&d=… (the official apps' scheme; Peel's own is
                 not decided, docs/phases/21-invites.md). Only fills in the onboarding's invite step:
                 nothing is joined or paid by opening a link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sphinx.chat" />
            </intent-filter>
            <!-- A stranger's public strut app to open in Peel, peel://open?url=<address>
                 (docs/phases/27-sign-in-with-sphinx.md). Read strictly by PublicAppLink; opening a link
                 loads the page and signs nothing: the person is asked, after tapping in the page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="peel" android:host="open" />
            </intent-filter>
        </activity>

        <!-- FCM: onNewToken re-registers the token, onMessageReceived is the
             push. Inert without a Firebase config (google-services.json). -->
        <service
            android:name=".push.PeelMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Keeps a running call alive in the background. -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Hands a downloaded attachment to whatever app the person
             picks to open it with (video/audio/PDF/file — an image
             shows inline instead), as a content:// URI rather than a
             raw file:// path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
