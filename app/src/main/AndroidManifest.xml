<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Voice messages (VoiceRecorder): the mic for a press-and-hold
         recording, requested at runtime, same as the system picker and
         camera already needed no manifest-time grant beyond this. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Calls (CallSession): the camera for a video call, requested at
         runtime, same as the mic above — RECORD_AUDIO already covers a
         call's own microphone, this is the one call-specific addition. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands a downloaded attachment to whatever app the person
             picks to open it with (video/audio/PDF/file — an image
             shows inline instead), as a content:// URI rather than a
             raw file:// path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
